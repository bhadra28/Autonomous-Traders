# Copy this file to .env and fill in your own keys. Never commit .env.

# Required
OPENAI_API_KEY=

# Web search for the researcher agent (https://tavily.com)
TAVILY_API_KEY=

# Optional: push notifications (https://pushover.net)
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Optional: real market data. Without it, simulated prices are used.
MASSIVE_API_KEY=

# Optional: only needed when USE_MANY_MODELS=true
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# Scheduler settings
RUN_EVERY_N_MINUTES=60
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false
USE_MANY_MODELS=false
